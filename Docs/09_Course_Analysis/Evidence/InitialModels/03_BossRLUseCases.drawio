" relative="1"><Array as="points"><mxPoint x="880" y="1585" /><mxPoint x="1700" y="1585" /></Array></mxGeometry></mxCell><mxCell id="A03_32" value="Boss模拟环境&lt;br&gt;状态推进 / 奖励" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#47627d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="2070" y="280" width="100" height="100" /></mxCell><mxCell id="A03_33" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A03_32" target="A03_12"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2020" y="195" /><mxPoint x="1180" y="195" /></Array></mxGeometry></mxCell><mxCell id="A03_34" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="A03_32" target="A03_13"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2010" y="580" /><mxPoint x="1180" y="580" /></Array></mxGeometry></mxCell><mxCell id="A03_35" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0.5;entryY=1;" edge="1" parent="1" source="A03_32" target="A03_27"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2190" y="600" /><mxPoint x="2190" y="1620" /><mxPoint x="1180" y="1620" /></Array></mxGeometry></mxCell><mxCell id="A03_36" value="UE战斗执行端&lt;br&gt;观测 / GAS / 实际终局" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#47627d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="2070" y="1120" width="100" height="100" /></mxCell><mxCell id="A03_37" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.2;entryX=0.5;entryY=1;" edge="1" parent="1" source="A03_36" target="A03_20"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1990" y="1140" /><mxPoint x="1180" y="1140" /></Array></mxGeometry></mxCell><mxCell id="A03_38" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A03_36" target="A03_21"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03_39" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="1" source="A03_36" target="A03_27"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="2000" y="1405" /><mxPoint x="1180" y="1405" /></Array></mxGeometry></mxCell><mxCell id="A03_40" value="include表示每次达成该目标所需的行为，不表示执行时间顺序；x扩展仅在守卫成立时执行。主要详细UC仍为R-UC-01～03。&lt;br&gt;完整合法响应清零；合法无动作不计故障；切BT保持至本场终局。遭遇可含多个策略段，回退战局独立归组。&lt;br&gt;选模与独测样本隔离，模拟器与UE分别报告。推理冻结参数；模型文件存在不等于UE已部署或完成正式对照。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="340" y="1700" width="1620" height="145" /></mxCell></root></mxGraphModel></diagram></mxfile>