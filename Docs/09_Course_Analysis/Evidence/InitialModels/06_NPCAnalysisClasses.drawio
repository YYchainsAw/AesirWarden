"-16" /></mxGeometry></mxCell><mxCell id="A06_53" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="A06_51"><mxGeometry as="geometry" x="0.78" y="0" relative="1"><mxPoint as="offset" x="0" y="-16" /></mxGeometry></mxCell><mxCell id="A06_54" value="允许使用" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0.85;entryY=0;" edge="1" parent="1" source="A06_12" target="A06_32"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1540" y="440" /><mxPoint x="1540" y="950" /><mxPoint x="1460" y="950" /></Array></mxGeometry></mxCell><mxCell id="A06_55" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="A06_54"><mxGeometry as="geometry" x="-0.78" y="0" relative="1"><mxPoint as="offset" x="0" y="-16" /></mxGeometry></mxCell><mxCell id="A06_56" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="A06_54"><mxGeometry as="geometry" x="0.78" y="0" relative="1"><mxPoint as="offset" x="0" y="-16" /></mxGeometry></mxCell><mxCell id="A06_57" value="DEC-03：具体每条指令允许引用几项技能尚未确定。&lt;br&gt;普通指令可以无技能引用；施法指令必须引用获准技能，引用须属于本角色的能力档案。&lt;br&gt;0..*是范围上界，不表示所有指令都可零技能。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="890" width="455" height="205" /></mxCell><mxCell id="A06_58" value="接收≠启动≠命中≠完成。只有实际发生的阶段才生成对应回执。&lt;br&gt;重试/过期/旧局/重复请求先检查执行身份；LLM建议不能绕过UE/GAS验证。&lt;br&gt;人格配置不拥有执行记录，重置记忆不清除身份、人格或关系。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="35" y="1115" width="455" height="165" /></mxCell></root></mxGraphModel></diagram></mxfile>