<mxfile host="app.diagrams.net"><diagram id="course" name="分析模型"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1760" pageHeight="1630" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A09_2" value="A09  Boss回退分析时序" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1700" height="38" /></mxCell><mxCell id="A09_3" value="COURSE-20261018-R1 · 分析目标视图 · R-UC-02 · BR-RL-01～03 · 已确认阈值3 / 0.25s周期 / 0.20s超时" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1700" height="40" /></mxCell><mxCell id="A09_4" value="Boss遭遇&lt;br&gt;BossEncounter" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="140" width="270" height="75" /></mxCell><mxCell id="A09_5" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="215" /><mxPoint as="targetPoint" x="180" y="1550" /></mxGeometry></mxCell><mxCell id="A09_6" value="决策协调&lt;br&gt;DecisionCoordinator" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="515" y="140" width="270" height="75" /></mxCell><mxCell id="A09_7" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="650" y="215" /><mxPoint as="targetPoint" x="650" y="1550" /></mxGeometry></mxCell><mxCell id="A09_8" value="PPO推理服务&lt;br&gt;PolicyService" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="985" y="140" width="270" height="75" /></mxCell><mxCell id="A09_9" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1120" y="215" /><mxPoint as="targetPoint" x="1120" y="1550" /></mxGeometry></mxCell><mxCell id="A09_10" value="共享动作执行&lt;br&gt;SharedExecutor / GAS" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1455" y="140" width="270" height="75" /></mxCell><mxCell id="A09_11" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1590" y="215" /><mxPoint as="targetPoint" x="1590" y="1550" /></mxGeometry></mxCell><mxCell id="A09_12" value="loop [Combat ∧ PPO有效 ∧ 无未决请求]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="245" width="1645" height="760" /></mxCell><mxCell id="A09_13" value="1 请求决策（游玩/遭遇/策略段身份）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="295" /><mxPoint as="targetPoint" x="650" y="295" /></mxGeometry></mxCell><mxCell id="A09_14" value="2 发送观测与requestId；启动0.20s超时" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="650" y="355" /><mxPoint as="targetPoint" x="1120" y="355" /></mxGeometry></mxCell><mxCell id="A09_15" value="3 响应（动作或合法无动作）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1120" y="415" /><mxPoint as="targetPoint" x="650" y="415" /></mxGeometry></mxCell><mxCell id="A09_16" value="alt [完整合法响应，且请求身份仍有效]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="445" width="1210" height="235" /></mxCell><mxCell id="A09_17" value="合法响应 → 故障计数清零；动作仍由共享执行器验证冷却、距离和GAS条件。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="480" width="1165" height="34" /></mxCell><mxCell id="A09_18" value="4a [有动作] 提交高层建议" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="650" y="555" /><mxPoint as="targetPoint" x="1590" y="555" /></mxGeometry></mxCell><mxCell id="A09_19" value="执行结果：接受 / 条件拒绝（不直接等于命中）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1590" y="615" /><mxPoint as="targetPoint" x="650" y="615" /></mxGeometry></mxCell><mxCell id="A09_20" value="[合法暂时无动作] 不调用执行器；清零计数，不算服务故障。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="640" width="1160" height="30" /></mxCell><mxCell id="A09_21" value="else [通信/超时、协议错误或非法动作]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="490" y="705" width="1210" height="255" /></mxCell><mxCell id="A09_22" value="4b 不执行错误动作；本请求只记一次故障，计数+1。&lt;br&gt;超时后的同一回包不重复计数；迟到响应也不能清零。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="755" width="1150" height="70" /></mxCell><mxCell id="A09_23" value="[计数&amp;lt;3] 下个合法周期再请求；[计数=3] 关闭PPO段，启用BT段。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=17;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="875" width="1150" height="45" /></mxCell><mxCell id="A09_24" value="opt [连续故障达到3次]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1040" width="1645" height="230" /></mxCell><mxCell id="A09_25" value="5 记录回退原因，结束旧策略段并开始BT段" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="650" y="1105" /><mxPoint as="targetPoint" x="180" y="1105" /></mxGeometry></mxCell><mxCell id="A09_26" value="6 BT通过同一执行器决策，保持到本场结束" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="650" y="1180" /><mxPoint as="targetPoint" x="1590" y="1180" /></mxGeometry></mxCell><mxCell id="A09_27" value="一次业务遭遇不因此重建；回退战局独立归组，不混为纯PPO样本。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="505" y="1220" width="1170" height="35" /></mxCell><mxCell id="A09_28" value="opt [玩家死亡 / Boss死亡 / 退出 / 重试]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1310" width="1645" height="220" /></mxCell><mxCell id="A09_29" value="7 关闭遭遇写权限、取消等待并失效请求身份" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="1375" /><mxPoint as="targetPoint" x="650" y="1375" /></mxGeometry></mxCell><mxCell id="A09_30" value="8 [迟到响应] 丢弃；不执行、不计新局故障" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1120" y="1445" /><mxPoint as="targetPoint" x="650" y="1445" /></mxGeometry></mxCell><mxCell id="A09_31" value="阶段边界：需求目标与模型检查；具体服务/UE故障注入尚待运行验证。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1570" width="1640" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>