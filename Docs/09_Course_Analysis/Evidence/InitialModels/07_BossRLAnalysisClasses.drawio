ckgroundColor=#ffffff;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="A07_24" target="A07_32"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1175" y="900" /><mxPoint x="865" y="900" /></Array></mxGeometry></mxCell><mxCell id="A07_65" value="0..1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="A07_64"><mxGeometry as="geometry" x="-0.78" y="0" relative="1"><mxPoint as="offset" x="0" y="-16" /></mxGeometry></mxCell><mxCell id="A07_66" value="0..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=17;fontFamily=Microsoft YaHei;labelBackgroundColor=#ffffff;" vertex="1" connectable="0" parent="A07_64"><mxGeometry as="geometry" x="0.78" y="0" relative="1"><mxPoint as="offset" x="0" y="-16" /></mxGeometry></mxCell><mxCell id="A07_67" value="约束：selectedArtifact ∈ candidates且恰好一个；独立评估样本不参与选模。&lt;br&gt;训练产生候选模型，不推导PPO优于BT。延迟与多样性按评估协议实测。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="365" width="515" height="155" /></mxCell><mxCell id="A07_68" value="遭遇≠遥测Episode。一次遭遇可跨多个记录段；回退不重开业务遭遇。&lt;br&gt;接收动作不代表命中。DecisionRecord的观测、响应与执行结果必须属于同一请求/遭遇/策略段。&lt;br&gt;BT段可以没有模型部署；结束时的Aborted遥测不等同玩家失败。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="805" width="520" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>