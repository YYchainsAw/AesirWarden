<mxfile host="app.diagrams.net"><diagram id="course" name="分析模型"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1620" pageHeight="1340" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A08_2" value="A08  游戏流程状态机" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1560" height="38" /></mxCell><mxCell id="A08_3" value="COURSE-20261018-R1 · 分析目标视图 · 观察对象：GameSession · BR-GAME-01～04/07 · DEC-01已确认" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1560" height="40" /></mxCell><mxCell id="A08_4" value="&lt;b&gt;Menu 菜单&lt;/b&gt;&lt;br&gt;&lt;br&gt;允许：开始、退出&lt;br&gt;禁用：伤害、Boss决策" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="170" width="330" height="165" /></mxCell><mxCell id="A08_5" value="&lt;b&gt;Opening 本局准备 / 入场演出&lt;/b&gt;&lt;br&gt;&lt;br&gt;初始状态有效，新游玩身份已发布&lt;br&gt;入场后仅一次建立遭遇&lt;br&gt;演出完成前禁止战斗" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="170" width="380" height="195" /></mxCell><mxCell id="A08_6" value="&lt;b&gt;Combat 战斗&lt;/b&gt;&lt;br&gt;&lt;br&gt;允许战斗输入、伤害、有效决策&lt;br&gt;仅当前游玩/遭遇可写入&lt;br&gt;统一竞争终局并关闭权限" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="170" width="350" height="195" /></mxCell><mxCell id="A08_7" value="&lt;b&gt;Restoring 重试恢复&lt;/b&gt;&lt;br&gt;&lt;br&gt;立即禁战斗、使旧请求失效&lt;br&gt;先清理，再恢复，再发布新身份&lt;br&gt;不在此阶段提前建立Boss遭遇" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="570" width="380" height="195" /></mxCell><mxCell id="A08_8" value="&lt;b&gt;Result 结算&lt;/b&gt;&lt;br&gt;&lt;br&gt;结果只确定一次&lt;br&gt;双方同帧死亡 → 失败&lt;br&gt;允许：重试、返回菜单、退出" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="570" width="350" height="195" /></mxCell><mxCell id="A08_9" value="&lt;b&gt;RecoveryError 恢复错误&lt;/b&gt;&lt;br&gt;&lt;br&gt;保持禁战斗，展示错误&lt;br&gt;允许：再次重试、返回菜单" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="570" width="330" height="180" /></mxCell><mxCell id="A08_10" value="&lt;b&gt;ReturningMenu 返回菜单&lt;/b&gt;&lt;br&gt;&lt;br&gt;关闭旧局与异步写入权限&lt;br&gt;执行菜单恢复，战斗保持禁用" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="650" y="1010" width="380" height="175" /></mxCell><mxCell id="A08_11" value="&lt;b&gt;MenuRecoveryError 菜单恢复错误&lt;/b&gt;&lt;br&gt;&lt;br&gt;保持禁战斗，展示错误&lt;br&gt;保留：再次重试、退出" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1010" width="330" height="175" /></mxCell><mxCell id="A08_12" value="&lt;b&gt;Closed 已退出&lt;/b&gt;&lt;br&gt;&lt;br&gt;停止接收本局异步消息&lt;br&gt;外部服务异常不阻塞退出" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#edf4fb;strokeColor=#6686a6;align=left;verticalAlign=top;spacing=14;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1220" y="1010" width="350" height="175" /></mxCell><mxCell id="A08_13" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#24364b;strokeColor=#24364b;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="235" width="26" height="26" /></mxCell><mxCell id="A08_14" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endSize=7;" edge="1" parent="1" source="A08_13" target="A08_4"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A08_15" value="开始 / 建立初始游玩" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endSize=7;exitX=1;exitY=0.4;entryX=0;entryY=0.4;" edge="1" parent="1" source="A08_4" target="A08_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A08_16" value="入场且演出完成" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;end