<mxfile host="app.diagrams.net"><diagram id="course" name="分析模型"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1840" pageHeight="1720" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A10_2" value="A10  NPC指令执行分析时序" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1780" height="38" /></mxCell><mxCell id="A10_3" value="COURSE-20261018-R1 · 分析目标视图 · NPC-UC02/05 · BR-NPC-01～04 · UE校验与真实阶段回执" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1780" height="40" /></mxCell><mxCell id="A10_4" value="玩家 / 调试人员" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="140" width="270" height="75" /></mxCell><mxCell id="A10_5" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="215" /><mxPoint as="targetPoint" x="180" y="1635" /></mxGeometry></mxCell><mxCell id="A10_6" value="同伴服务&lt;br&gt;含建议生成与上下文" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="140" width="270" height="75" /></mxCell><mxCell id="A10_7" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="215" /><mxPoint as="targetPoint" x="670" y="1635" /></mxGeometry></mxCell><mxCell id="A10_8" value="UE接入边界&lt;br&gt;校验与回执" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1025" y="140" width="270" height="75" /></mxCell><mxCell id="A10_9" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="215" /><mxPoint as="targetPoint" x="1160" y="1635" /></mxGeometry></mxCell><mxCell id="A10_10" value="UE / GAS执行器" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=#eaf2fa;strokeColor=#6686a6;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1515" y="140" width="270" height="75" /></mxCell><mxCell id="A10_11" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;dashPattern=5 5;strokeColor=#8b9bab;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1650" y="215" /><mxPoint as="targetPoint" x="1650" y="1635" /></mxGeometry></mxCell><mxCell id="A10_12" value="1 指令请求（gameId / roleId / eventId + 上下文）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="180" y="285" /><mxPoint as="targetPoint" x="670" y="285" /></mxGeometry></mxCell><mxCell id="A10_13" value="LLM/ASR是服务外部协作者；语音入口差异见NPC-UC03，凭据不交给UE。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="275" y="320" width="1410" height="40" /></mxCell><mxCell id="A10_14" value="2 建议（directiveId / 作用域 / 有效期 / 条件能力引用）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="405" /><mxPoint as="targetPoint" x="1160" y="405" /></mxGeometry></mxCell><mxCell id="A10_15" value="alt [旧局 / 过期 / 越权 / 语义不合法]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="455" width="1270" height="195" /></mxCell><mxCell id="A10_16" value="3a 拒绝及稳定原因；不执行、不报完成" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="530" /><mxPoint as="targetPoint" x="670" y="530" /></mxGeometry></mxCell><mxCell id="A10_17" value="普通指令可无技能；施法须引用本角色获准技能；具体数量DEC-03待定。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="580" width="1215" height="40" /></mxCell><mxCell id="A10_18" value="else [当前有效且首次合法建议]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="690" width="1270" height="510" /></mxCell><mxCell id="A10_19" value="3b 收到 / 校验通过（仅代表已接收）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="755" /><mxPoint as="targetPoint" x="670" y="755" /></mxGeometry></mxCell><mxCell id="A10_20" value="4 尝试执行（再查实时状态 / 冷却 / 能力）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="825" /><mxPoint as="targetPoint" x="1650" y="825" /></mxGeometry></mxCell><mxCell id="A10_21" value="5 [实际启动] started；[启动失败] rejected + reason" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1650" y="895" /><mxPoint as="targetPoint" x="1160" y="895" /></mxGeometry></mxCell><mxCell id="A10_22" value="6 仅转发实际启动或拒绝阶段" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="960" /><mxPoint as="targetPoint" x="670" y="960" /></mxGeometry></mxCell><mxCell id="A10_23" value="7 [实际发生] hit / completed / failed" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1650" y="1035" /><mxPoint as="targetPoint" x="1160" y="1035" /></mxGeometry></mxCell><mxCell id="A10_24" value="8 真实阶段 / 终态回执（执行键 + 阶段 + 原因）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="1110" /><mxPoint as="targetPoint" x="670" y="1110" /></mxGeometry></mxCell><mxCell id="A10_25" value="并非每条指令都有命中阶段；没有发生的阶段不得补造。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="1150" width="1215" height="34" /></mxCell><mxCell id="A10_26" value="opt [请求重发 / 回执重复或乱序]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="1240" width="1270" height="210" /></mxCell><mxCell id="A10_27" value="9 重发同一执行身份（去重窗口内）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="1305" /><mxPoint as="targetPoint" x="1160" y="1305" /></mxGeometry></mxCell><mxCell id="A10_28" value="10 返回已知状态，不再次执行；服务按合法阶段合并" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="1380" /><mxPoint as="targetPoint" x="670" y="1380" /></mxGeometry></mxCell><mxCell id="A10_29" value="作用域：gameId + roleId + eventId + directiveId，并校验游玩/上下文有效版本。&lt;br&gt;有限缓存去重不承诺跨进程重启的永久恰好一次；具体保留期和外发数据见DEC-05。&lt;br&gt;重试先使旧执行身份失效；记忆重置不清除角色身份、人格和关系。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1490" width="1680" height="140" /></mxCell><mxCell id="A10_30" value="当前协议提供的状态与目标阶段须分别核对；本图不宣称服务与游戏已完成上述阶段回传。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1660" width="1680" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>