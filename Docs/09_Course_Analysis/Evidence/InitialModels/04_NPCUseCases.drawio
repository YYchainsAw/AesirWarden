etry as="geometry" relative="1" /></mxCell><mxCell id="A04_25" value="可选大模型服务" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#47627d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="275" width="100" height="100" /></mxCell><mxCell id="A04_26" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A04_25" target="A04_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A04_27" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A04_25" target="A04_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A04_28" value="可选外部语音识别" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;fillColor=#ffffff;strokeColor=#47627d;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1280" y="575" width="100" height="100" /></mxCell><mxCell id="A04_29" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="A04_28" target="A04_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A04_30" value="边界：玩家经UE提交；调试人员经允许的服务调试通路查询/清记忆，实际通路仍需对齐，不要求游戏按钮。&lt;br&gt;自主与事件用例由UE触发，玩家受益。服务仅响应心跳/快照，可无动作；不主动修改游戏世界。&lt;br&gt;技能按指令类型条件引用且必须获准，数量未冻结；接收建议不等于已执行/命中/完成。记忆重置保留人格与关系，部分失败如实报告。&lt;br&gt;外部后端可选，允许外发与保留范围见DEC-05；角色、能力和请求均须校验作用域。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="1425" width="1120" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>