      </mxGeometry>
    </mxCell>
    <mxCell id="A10_condition" value="条件触发 / 即时执行时，再查当前遭遇、目标与TTL。&lt;br&gt;检查当前GAS及不可打断窗口；断网保留有效已登记条件。&lt;br&gt;新遭遇不恢复旧命令。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="1210" y="1180" width="540" height="95" />
    </mxCell>
    <mxCell id="A10_23" value="7 [实际启动] started；[启动失败] rejected + reason" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
