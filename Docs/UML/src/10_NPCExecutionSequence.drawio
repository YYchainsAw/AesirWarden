        <mxPoint as="sourcePoint" x="670" y="1395" />
        <mxPoint as="targetPoint" x="1160" y="1395" />
      </mxGeometry>
    </mxCell>
    <mxCell id="A10_25" value="9 [仅实际启动后] 命中 / 完成 / 失败的真实结果" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
      <mxGeometry as="geometry" relative="1">
