    <mxCell id="A10_24" value="8 仅上传实际启动 / 拒绝阶段" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
