ei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="530" /><mxPoint as="targetPoint" x="1160" y="530" /></mxGeometry></mxCell><mxCell id="A10_18" value="普通指令可无技能；施法须引用本角色获准技能；具体数量DEC-03待定。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="580" width="1215" height="40" /></mxCell><mxCell id="A10_19" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#8597a8;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="510" y="685" /><mxPoint as="targetPoint" x="1780" y="685" /></mxGeometry></mxCell><mxCell id="A10_20" value="[else：当前有效且首次合法建议]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="695" width="1215" height="35" /></mxCell><mxCell id="A10_21" value="4b 收到 / 校验通过（仅代表已接收）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="755" /><mxPoint as="targetPoint" x="1160" y="755" /></mxGeometry></mxCell><mxCell id="A10_22" value="5 尝试执行（再查实时状态 / 冷却 / 能力）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="825" /><mxPoint as="targetPoint" x="1650" y="825" /></mxGeometry></mxCell><mxCell id="A10_23" value="6 [实际启动] started；[启动失败] rejected + reason" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1650" y="895" /><mxPoint as="targetPoint" x="670" y="895" /></mxGeometry></mxCell><mxCell id="A10_24" value="7 仅转发实际启动或拒绝阶段" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="960" /><mxPoint as="targetPoint" x="1160" y="960" /></mxGeometry></mxCell><mxCell id="A10_25" value="8 [仅实际启动后] hit / completed / failed" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1650" y="1035" /><mxPoint as="targetPoint" x="670" y="1035" /></mxGeometry></mxCell><mxCell id="A10_26" value="9 真实阶段 / 终态回执（执行键 + 阶段 + 原因）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="1110" /><mxPoint as="targetPoint" x="1160" y="1110" /></mxGeometry></mxCell><mxCell id="A10_27" value="启动失败即拒绝终态，不再进入步骤8；并非每条指令都有命中阶段。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="535" y="1150" width="1215" height="34" /></mxCell><mxCell id="A10_28" value="opt" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="510" y="1240" width="1270" height="210" /></mxCell><mxCell id="A10_29" value="[请求重发 / 回执重复或乱序]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="595" y="1246" width="1160" height="32" /></mxCell><mxCell id="A10_30" value="10 重发同一执行身份（去重窗口内）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1160" y="1305" /><mxPoint as="targetPoint" x="670" y="1305" /></mxGeometry></mxCell><mxCell id="A10_31" value="11 返回已知状态，不再次执行；服务按合法阶段合并" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="670" y="1380" /><mxPoint as="targetPoint" x="1160" y="1380" /></mxGeometry></mxCell><mxCell id="A10_32" value="指令执行键关联gameId、roleId、游玩/遭遇与directiveId；eventId仅用于可信事实事件，不强加给所有文本指令。&lt;br&gt;NPC-UC05从步骤2开始：UE提交可信事件，服务先幂等更新记忆/关系，再复用建议与回执链。&lt;br&gt;有限缓存不承诺跨重启永久恰好一次；LLM/ASR外发与保留见DEC-05。重试失效旧指令，不清长期记忆或关系。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="65" y="1490" width="1680" height="140" /></mxCell><mxCell id="A10_33" value="当前协议提供的状态与目标阶段须分别核对；本图不宣称服务与游戏已完成上述阶段回传。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="70" y="1660" width="1680" height="35" /></mxCell></root></mxGraphModel></diagram></mxfile>