    <mxCell id="A10_auth" value="3 验证玩家 / 存档作用域&lt;br&gt;查询持久幂等键及请求内容&lt;br&gt;首次：生成并保存原结果&lt;br&gt;重复：回放；同键异内容：冲突" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1">
