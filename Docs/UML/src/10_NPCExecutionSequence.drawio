        <mxPoint as="targetPoint" x="670" y="1480" />
      </mxGeometry>
    </mxCell>
    <mxCell id="A10_26" value="10 关联原命令及作用域的真实回执" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
      <mxGeometry as="geometry" relative="1">
        <mxPoint as="sourcePoint" x="670" y="1560" />
        <mxPoint as="targetPoint" x="1160" y="1560" />
      </mxGeometry>
    </mxCell>
    <mxCell id="A10_27" value="启动失败即终态，不再进入步骤9；并非每条指令有命中。回执持久合并后确认，生成/接受不计为完成。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="535" y="1590" width="1215" height="40" />
    </mxCell>
    <mxCell id="A10_28" value="opt" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlFrame;fillColor=none;strokeColor=#8597a8;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=16;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="510" y="1690" width="1270" height="295" />
    </mxCell>
    <mxCell id="A10_29" value="[请求 / 回执重传；确认丢失；服务重启；重复或乱序]" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="595" y="1700" width="1160" height="32" />
    </mxCell>
    <mxCell id="A10_30" value="11 重传同一逻辑命令或稳定回执ID（保持原作用域）" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=block;endFill=1;endSize=7;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
      <mxGeometry as="geometry" relative="1">
        <mxPoint as="sourcePoint" x="670" y="1795" />
        <mxPoint as="targetPoint" x="1160" y="1795" />
      </mxGeometry>
    </mxCell>
    <mxCell id="A10_31" value="12 持久回放 / 合并原结果，确认后移除本地待传项" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;endSize=7;dashed=1;fontSize=16;verticalAlign=bottom;spacingBottom=6;" edge="1" parent="1">
      <mxGeometry as="geometry" relative="1">
        <mxPoint as="sourcePoint" x="1160" y="1885" />
        <mxPoint as="targetPoint" x="670" y="1885" />
      </mxGeometry>
    </mxCell>
    <mxCell id="A10_dedup" value="UE按原命令防重复启动；服务校验合法阶段与终态，重复/乱序不得倒退。&lt;br&gt;通知丢失可按游标补拉；旧事实可归档原局，不重放当前世界动作。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="535" y="1910" width="1215" height="60" />
    </mxCell>
    <mxCell id="A10_32" value="scope含认证玩家 / 游戏 / 存档分支 / 角色；会话、游玩和遭遇分别保留生命周期。&lt;br&gt;NPC-UC04从步骤2心跳输入，纯规则仲裁；NPC-UC05从可信事件输入，先持久幂等再更新事实/关系。&lt;br&gt;取消/重试使旧回包失效，不清长期记忆或关系；记忆清理另受reset generation屏障约束。&lt;br&gt;模型为DEP / EVO目标，不承诺任意故障下永久exactly-once；外发及保留见DEC-05。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="65" y="2040" width="1680" height="140" />
    </mxCell>
    <mxCell id="A10_33" value="当前协议为accepted/executed/rejected/expired/cancelled；started / hit / completed等目标阶段须版本化对齐。&lt;br&gt;本图未宣称接口、UE执行或上述持久化已经实现/验收。检查：NPC-EVO-04/06；DEP-UE-03/04。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1">
      <mxGeometry as="geometry" x="70" y="2220" width="1680" height="75" />
    </mxCell>
  </root>
