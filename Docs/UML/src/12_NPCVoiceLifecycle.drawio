oint" x="1580" y="1055" /></mxGeometry></mxCell><mxCell id="n30" value="取消仍在运行的生成 / 合成" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095.0" y="1006" width="470" height="45" /></mxCell><mxCell id="n31" value="" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;whiteSpace=nowrap;edgeStyle=none;rounded=0;strokeColor=#4b6177;fontSize=19;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1580" y="1130" /><mxPoint as="targetPoint" x="1080" y="1130" /></mxGeometry></mxCell><mxCell id="n32" value="迟到片段：按已失效轮次丢弃" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095.0" y="1081" width="470" height="45" /></mxCell><mxCell id="n33" value="" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;whiteSpace=nowrap;edgeStyle=none;rounded=0;strokeColor=#4b6177;fontSize=19;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1080" y="1205" /><mxPoint as="targetPoint" x="600" y="1205" /></mxGeometry></mxCell><mxCell id="n34" value="取消 / 中断处理状态，非已播确认" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="615.0" y="1156" width="450" height="45" /></mxCell><mxCell id="n35" value="回声处理：NPC 自身播放音频不再次触发玩家命令。新输入创建新轮次，旧片段不能重新入队。&lt;br&gt;取消不撤销已发生的世界事实，也不绕过 GAS 不可打断规则。若要边生成边播，先定义句级确认与最终修正语义。" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="1300" width="1710" height="105" /></mxCell></root></mxGraphModel></diagram></mxfile>