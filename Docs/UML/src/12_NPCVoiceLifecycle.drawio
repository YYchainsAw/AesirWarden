metry" x="615.0" y="471" width="450" height="45" /></mxCell><mxCell id="n19" value="" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;whiteSpace=nowrap;edgeStyle=none;rounded=0;strokeColor=#4b6177;fontSize=19;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1580" y="600" /><mxPoint as="targetPoint" x="1080" y="600" /></mxGeometry></mxCell><mxCell id="n20" value="片段 0 完成" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="1095.0" y="551" width="470" height="45" /></mxCell><mxCell id="n21" value="" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;whiteSpace=nowrap;edgeStyle=none;rounded=0;strokeColor=#4b6177;fontSize=19;labelBackgroundColor=#ffffff;endArrow=open;endFill=0;dashed=1;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="1080" y="675" /><mxPoint as="targetPoint" x="600" y="675" /></mxGeometry></mxCell><mxCell id="n22" value="轮次 + 序号 0：按 0 → 1 播放" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=center;verticalAlign=middle;strokeColor=none;fillColor=none;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="615.0" y="626" width="450" height="45" /></mxCell><mxCell id="n23" value="UE 维护播放顺序与实际已播边界&lt;br&gt;合成完成 ≠ 播放完成；失败保留字幕" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=#f8fafc;align=center;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="385" y="710" width="430" height="70" /></mxCell><mxCell id="n24" value="" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;whiteSpace=nowrap;edgeStyle=none;