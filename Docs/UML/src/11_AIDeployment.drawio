<mxfile host="app.diagrams.net" agent="draw.io" version="28.2.0"><diagram id="deployment" name="部署与权威边界"><mxGraphModel dx="1800" dy="1180" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1180" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n1" value="A11 AI 部署与权威边界" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="25" width="1720" height="55" /></mxCell><mxCell id="n2" value="DEP-20261021 / EVO-20261021 目标模型　｜　非部署或运行证据　｜　关联 AI-DEP-01～15、C1～C4、G1、V1～V4" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=18;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="85" width="1720" height="60" /></mxCell><mxCell id="n3" value="«device» 玩家 Windows 客户端" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;swimlane;startSize=52;horizontal=1;collapsible=0;rounded=0;fillColor=#eaf2fa;swimlaneFillColor=#f8fafc;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="45" y="175" width="510" height="800" /></mxCell><mxCell id="n4" value="«executionEnvironment» 远程 NPC 服务" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;swimlane;startSize=52;horizontal=1;collapsible=0;rounded=0;fillColor=#eaf2fa;swimlaneFillColor=#f8fafc;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="695" y="175" width="550" height="875" /></mxCell><mxCell id="n5" value="«external» 配置的供应商" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;swimlane;startSize=52;horizontal=1;collapsible=0;rounded=0;fillColor=#f0f3f7;swimlaneFillColor=#f8fafc;fontSize=23;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="1385" y="175" width="370" height="800" /></mxCell><mxCell id="n6" value="&lt;b&gt;«artifact» UE 游戏进程&lt;/b&gt;&lt;br&gt;&lt;br&gt;世界状态 / 当前目标 / BT 即时行为&lt;br&gt;技能合法性 / GAS / 命中与伤害&lt;br&gt;&lt;br&gt;本地录音、字幕、播放与取消&lt;br&gt;后置：VAD、音频片段队列、打断&lt;br&gt;&lt;br&gt;世界与执行结果的权威" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n3"><mxGeometry as="geometry" x="30" y="85" width="450" height="365" /></mxCell><mxCell id="n7" value="&lt;b&gt;«process» Boss 推理&lt;/b&gt;&lt;br&gt;&lt;br&gt;冻结 PPO / CPU&lt;br&gt;回环监听；失败转本地 BT" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;fontSize=18;" vertex="1" parent="n3"><mxGeometry as="geometry" x="30" y="550" width="210" height="215" /></mxCell><mxCell id="n8" value="&lt;b&gt;«artifact» 本地缓存&lt;/b&gt;&lt;br&gt;&lt;br&gt;玩家 / 档 / 角色分区&lt;br&gt;版本与真实事实队列&lt;br&gt;持久确认后移出" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;fontSize=18;" vertex="1" parent="n3"><mxGeometry as="geometry" x="270" y="550" width="210" height="215" /></mxCell><mxCell id="n9" value="&lt;b&gt;«artifact» 认证与 HTTPS API&lt;/b&gt;&lt;br&gt;&lt;br&gt;验证玩家、存档归属和作用域&lt;br&gt;限额 / 期限 / 取消传播 / 关联 ID" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n4"><mxGeometry as="geometry" x="30" y="85" width="490" height="135" /></mxCell><mxCell id="n10" value="&lt;b&gt;«artifact» NPC 编排&lt;/b&gt;&lt;br&gt;&lt;br&gt;人格 / 会话队列 / 检索 / 高层建议&lt;br&gt;外部 LLM、ASR 及后置 TTS 适配&lt;br&gt;供应商密钥仅保留在服务器" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n4"><mxGeometry as="geometry" x="30" y="290" width="490" height="170" /></mxCell><mxCell id="n11" value="&lt;b&gt;«database» 权威持久存储&lt;/b&gt;&lt;br&gt;&lt;br&gt;记忆 / 关系 / 命令结果 / 回执&lt;br&gt;事务与持久幂等 / 版本与重置屏障&lt;br&gt;数据库选型沿用服务侧设计" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n4"><mxGeometry as="geometry" x="30" y="535" width="490" height="175" /></mxCell><mxCell id="n12" value="&lt;b&gt;«artifact» 同步与恢复&lt;/b&gt;&lt;br&gt;&lt;br&gt;同一认证入口 / 持久确认 / 游标补拉&lt;br&gt;旧代拒绝；通知不等于持久保存" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n4"><mxGeometry as="geometry" x="30" y="745" width="490" height="120" /></mxCell><mxCell id="n13" value="&lt;b&gt;«service» LLM&lt;/b&gt;&lt;br&gt;&lt;br&gt;允许的文本与上下文&lt;br&gt;返回文本 / 结构化建议" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n5"><mxGeometry as="geometry" x="30" y="85" width="310" height="160" /></mxCell><mxCell id="n14" value="&lt;b&gt;«service» ASR&lt;/b&gt;&lt;br&gt;&lt;br&gt;必要音频 → 转写&lt;br&gt;最终转写进入原校验" style="fontFamily=Microsoft YaHei;fontSize=20;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;strokeColor=#6b8096;fillColor=#ffffff;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="n5"><mxGeometry as="geometry" x="30" y="350" width="310" height="160" /></mxCell><mxCell id="n15" value="&lt;b&gt;«service» 后置 TTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;确认文本 → 音频片段&lt;br&gt;失败保留字幕" style="fontFamily=Microsoft YaHei;fontSiz