Hei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A02_13" target="A02_10"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A02_21" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A02_13" target="A02_11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A02_22" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A02_13" target="A02_12"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A02_23" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1330" y="650" width="85" height="105" /></mxCell><mxCell id="A02_24" value="冻结Boss策略服务&lt;br&gt;仅PPO模式" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1245" y="762" width="255" height="72" /></mxCell><mxCell id="A02_25" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A02_23" target="A02_8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A02_26" value="本页只展开GAME-FR01～08；NPC协作仍保留在整组A01和服务A04，未删除NPC需求。&lt;br&gt;开始、结算与重试的先后由A08表达，不用include/extend代替时间顺序。结果页提供重试、返回菜单、退出；双方同帧死亡为失败。&lt;br&gt;重试成功直接到关卡初始可操作探索点，尚无新遭遇；恢复失败禁战斗，可重试或回菜单，菜单也失败可重试菜单恢复或退出。&lt;br&gt;外部服务无响应不阻塞菜单、结算、恢复和退出。PPO只提出高层建议，UE/GAS拥有执行权。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="450" y="1380" width="690" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>