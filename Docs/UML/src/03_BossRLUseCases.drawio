x="1" parent="1"><mxGeometry as="geometry" x="110" y="540" width="85" height="105" /></mxCell><mxCell id="A03c_10" value="开发与研究人员" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="652" width="255" height="72" /></mxCell><mxCell id="A03c_11" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A03c_9" target="A03c_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_12" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="385" width="85" height="105" /></mxCell><mxCell id="A03c_13" value="Boss模拟环境" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1555" y="497" width="255" height="72" /></mxCell><mxCell id="A03c_14" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.25;" edge="1" parent="1" source="A03c_12" target="A03c_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_15" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1640" y="795" width="85" height="105" /></mxCell><mxCell id="A03c_16" value="UE战斗执行端" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1555" y="907" width="255" height="72" /></mxCell><mxCell id="A03c_17" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.75;" edge="1" parent="1" source="A03c_15" target="A03c_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_18" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03c_5" target="A03c_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_19" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03c_5" target="A03c_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_20" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03c_5" target="A03c_8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03c_21" value="三项辅助行为均是独立评估目标的一部分；参与线不表执行顺序。&lt;br&gt;选模与独立样本隔离；模拟器规则基线与UE行为树分别报告，不混作同一环境结果。&lt;br&gt;冻结模型、配置、条件和统计口径，保留原始样本。完整PPO、BT、回退与Aborted分开归组，不预填性能或胜率结论。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="1130" width="1130" height="145" /></mxCell></root></mxGraphModel></diagram></mxfile>