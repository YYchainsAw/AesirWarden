<mxfile host="app.diagrams.net"><diagram id="course" name="训练与选模"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1850" pageHeight="1150" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A03a_2" value="A03a  RL训练与选模用例" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1790" height="38" /></mxCell><mxCell id="A03a_3" value="COURSE-20261018-R1 · 分析目标视图 · R-UC-01 · 辅助a/b/x不增加主要UC计数" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1790" height="40" /></mxCell><mxCell id="A03a_4" value="Boss RL工作流：离线训练与选模" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=#738ca4;align=left;verticalAlign=top;spacing=14;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="140" width="1130" height="760" /></mxCell><mxCell id="A03a_5" value="R-UC-01&lt;br&gt;训练并选择候选策略" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="430" width="360" height="115" /></mxCell><mxCell id="A03a_6" value="R-UC-01.a 训练候选并保存产物&lt;br&gt;扩展点：开始 / 恢复训练" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="250" width="390" height="135" /></mxCell><mxCell id="A03a_7" value="R-UC-01.b&lt;br&gt;比较候选并记录选择" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="650" width="390" height="110" /></mxCell><mxCell id="A03a_8" value="R-UC-01.x&lt;br&gt;从兼容检查点恢复" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="690" width="360" height="110" /></mxCell><mxCell id="A03a_9" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="410" width="85" height="105" /></mxCell><mxCell id="A03a_10" value="开发与研究人员" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="522" width="255" height="72" /></mxCell><mxCell id="A03a_11" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A03a_9" target="A03a_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_12" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1630" y="420" width="85" height="105" /></mxCell><mxCell id="A03a_13" value="Boss模拟环境&lt;br&gt;状态推进与奖励" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1545" y="532" width="255" height="72" /></mxCell><mxCell id="A03a_14" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A03a_12" target="A03a_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_15" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A03a_12" target="A03a_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_16" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03a_5" target="A03a_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_17" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03a_5" target="A03a_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_18" value="«extend»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03a_8" target="A03a_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03a_19" value="扩展守卫：训练中断且存在兼容检查点；扩展箭头指向基础行为01.a。&lt;br&gt;include表示达成目标所需行为，不表示执行先后；选择的产物属于候选集合，恰好一个。&lt;br&gt;选模样本不作独立评估样本。训练产物与来源可追溯，不预设PPO优于BT。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="960" width="1130" height="145" /></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="部署与回退"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1850" pageHeight="1170" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A03b_2" value="A03b  RL部署与回退用例" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1790" height="38" /></mxCell><mxCell id="A03b_3" value="COURSE-20261018-R1 · 分析目标视图 · R-UC-02 · BR-RL-01～04 · 辅助a/b/x" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1790" height="40" /></mxCell><mxCell id="A03b_4" value="冻结推理与UE策略接入协调（不含世界推进 / GAS）" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=#738ca4;align=left;verticalAlign=top;spacing=14;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="140" width="1130" height="790" /></mxCell><mxCell id="A03b_5" value="R-UC-02&lt;br&gt;部署冻结策略并接入战斗" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="430" width="360" height="115" /></mxCell><mxCell id="A03b_6" value="R-UC-02.a&lt;br&gt;校验并加载冻结模型" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="250" width="390" height="110" /></mxCell><mxCell id="A03b_7" value="R-UC-02.b 动作建议 / 合法无动作&lt;br&gt;扩展点：有效响应或受控失败" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="990" y="655" width="390" height="140" /></mxCell><mxCell id="A03b_8" value="R-UC-02.x&lt;br&gt;记录故障并切BT接管" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="470" y="710" width="360" height="110" /></mxCell><mxCell id="A03b_9" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="410" width="85" height="105" /></mxCell><mxCell id="A03b_10" value="开发与研究人员" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="522" width="255" height="72" /></mxCell><mxCell id="A03b_11" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.5;" edge="1" parent="1" source="A03b_9" target="A03b_5"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_12" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1630" y="670" width="85" height="105" /></mxCell><mxCell id="A03b_13" value="UE战斗执行端&lt;br&gt;观测 / GAS / 实际终局" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1545" y="782" width="255" height="72" /></mxCell><mxCell id="A03b_14" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A03b_12" target="A03b_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_16" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="110" y="740" width="85" height="105" /></mxCell><mxCell id="A03b_17" value="UE执行端（同一角色）" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="25" y="852" width="255" height="72" /></mxCell><mxCell id="A03b_18" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=0;entryY=0.65;" edge="1" parent="1" source="A03b_16" target="A03b_8"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_19" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03b_5" target="A03b_6"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_20" value="«include»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03b_5" target="A03b_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_21" value="«extend»" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;dashed=1;endArrow=open;endSize=10;" edge="1" parent="1" source="A03b_8" target="A03b_7"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A03b_22" value="扩展守卫：通信 / 协议 / 非法动作连续失败3次。完整合法响应清零，合法无动作不计故障。&lt;br&gt;切BT后保持到本场终局；同一遭遇可含多个策略记录段，回退样本独立归组。迟到PPO响应不能夺回执行权。&lt;br&gt;include不表达时序，x仅在守卫成立时扩展；动态故障、终局和迟到消息见A09。模型文件存在不等于已完成UE部署。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="990" width="1130" height="145" /></mxCell></root></mxGraphModel></diagram><diagram id="page-2" name="独立评估"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1880" pageHeight="1310" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A03c_2" value="A03c  RL独立评估用例" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1820" height="38" /></mxCell><mxCell id="A03c_3" value="COURSE-20261018-R1 · 分析目标视图 · R-UC-03 · BR-RL-05 · 分环境报告" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;w