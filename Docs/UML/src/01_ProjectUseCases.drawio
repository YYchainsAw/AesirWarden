4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A01_31" target="A01_17"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A01_34" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.5;" edge="1" parent="1" source="A01_31" target="A01_18"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A01_35" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="1450" y="1230" width="85" height="105" /></mxCell><mxCell id="A01_36" value="可选外部ASR" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;fillColor=none;strokeColor=none;align=center;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry as="geometry" x="1365" y="1342" width="255" height="72" /></mxCell><mxCell id="A01_37" value="" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;entryX=1;entryY=0.7;" edge="1" parent="1" source="A01_35" target="A01_18"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A01_38" value="总览中的游戏与N编号为阅读摘要，不增加原18个主要详细UC计数。完整目标见A02～A04。&lt;br&gt;N01→NPC-UC01；N02→02/03；N03→04/05；N04→06；N05→07。&lt;br&gt;UE与两个Python服务在整组边界内；LLM/ASR仅在配置启用时为外部协作者。自主/事件由内部UE触发，玩家受益。&lt;br&gt;实线表示参与，不表示执行顺序。BT/PPO正式对照不加入同伴变量；重置记忆是服务调试目标，不要求游戏按钮。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="1730" width="840" height="165" /></mxCell></root></mxGraphModel></diagram></mxfile>