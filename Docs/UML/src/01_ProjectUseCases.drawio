<mxfile host="app.diagrams.net"><diagram id="course" name="分析模型"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1940" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A01_2" value="A01  整组系统用例总览" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1640" height="38" /></mxCell><mxCell id="A01_3" value="COURSE-20261018-R1 · 分析目标视图 · 同名参与者重复绘制仅为别名 · 参与线均为单段直线" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1640" height="40" /></mxCell><mxCell id="A01_4" value="整组系统：UE游戏 + Boss RL工作流/推理 + NPC服务" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;rounded=0;fillColor=none;strokeColor=#738ca4;align=left;verticalAlign=top;spacing=14;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry as="geometry" x="420" y="140" width="840" height="1530" /></mxCell><mxCell id="A01_5" value="G-UC-01～08 游戏流程摘要&lt;br&gt;开始、探索、挑战、战斗、结算&lt;br&gt;重试、返回菜单及退出" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;ellipse;fillColor=#edf4fb;strokeColor=#6587aa;spacing=10;fontSize=19;" vertex="1" parent="1"><mxGeometry as="geometry" x="620" y="220" width="460" height="135" /></mxCell><mxCell id="A01_6" value="" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=umlActor;fillColor=#ffffff;strokeColor=#47627d;" vertex="1" parent="1"><mxGeometry as="geometry" x="140" y="225" width