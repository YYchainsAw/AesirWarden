olor=#24364b;strokeColor=#24364b;" vertex="1" parent="A08a_29"><mxGeometry as="geometry" x="7" y="7" width="20" height="20" /></mxCell><mxCell id="A08a_31" value="菜单恢复错误 / 退出" style="html=1;fontFamily=Microsoft YaHei;fontSize=16;fontColor=#24364b;strokeColor=#4b6177;endArrow=none;rounded=0;labelBackgroundColor=#ffffff;edgeStyle=none;endArrow=block;endSize=7;" edge="1" parent="1" source="A08a_10" target="A08a_29"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="A08a_32" value="final表示结束游戏会话并停止旧局异步写入，不等待外部服务。&lt;br&gt;探索允许适用的玩家战斗，Boss决策仅在Combat开放；开场、入场、菜单、恢复与结果禁战斗。&lt;br&gt;重试跳过菜单 / 开场，不提前建立遭遇。恢复失败的具体合法出口、重复点击和迟到恢复见A08b。" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;shape=note;size=14;fillColor=#fff6dc;strokeColor=#c9ad64;align=left;verticalAlign=top;spacing=12;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1130" y="1460" width="880" height="140" /></mxCell></root></mxGraphModel></diagram><diagram id="page-1" name="恢复子状态机"><mxGraphModel dx="1540" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1950" pageHeight="1550" math="0" shadow="0" background="#ffffff" adaptiveColors="auto"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="A08b_2" value="A08b  恢复子状态机" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="20" width="1890" height="38" /></mxCell><mxCell id="A08b_3" value="COURSE-20261018-R1 · 分析目标视图 · A08a的Recovery细化 · G-UC-06 / BR-GAME-03～04" style="fontFamily=Microsoft YaHei;fontSize=17;fontColor=#24364b;html=1;whiteSpace=wrap;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;spacing=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="66" width="1890" height="4