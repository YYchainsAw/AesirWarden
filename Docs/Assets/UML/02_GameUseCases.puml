@startuml GameUseCases
' Diagram: SRS-G-01; Model: To-Be / requirements baseline 2026-10-08
' Purpose: player goals within the Unreal game client boundary
' UE: develop ea4c8052f5df319c2d3b7b8c8dfcf2f684efb408
' AI: main 1678dd6a467bc2fd9c077124ede527a82958e332
' Evidence: GDD/01_GameFlow.md; GDD/03_CombatDesign.md; 01_VerificationMatrix.md
' Existing source and assets do not prove all target flows have passed runtime acceptance.
title AesirWarden — 游戏客户端用例模型（需求目标）
left to right direction
skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FAFAF7
skinparam shadowing false
skinparam packageStyle rectangle

actor "玩家" as Player
actor "Boss 冻结策略服务\n:8012（M2）" as BossService
actor "NPC 服务\n端口与 UE 配置一致（M5）" as NpcService

rectangle "AesirWarden 游戏客户端（UE 权威端）" {
  package "完整游玩流程 · M1" {
    usecase "G-UC-01\n开始游戏" as Start
    usecase "G-UC-02\n探索关卡" as Explore
    usecase "G-UC-03\n挑战 Boss" as Challenge
    usecase "G-UC-04\n进行战斗操作" as Combat
    usecase "G-UC-05\n查看胜败结果" as Results
    usecase "G-UC-06\n重试关卡" as Retry
    usecase "G-UC-07\n返回主菜单" as Menu
    usecase "G-UC-08\n退出游戏" as Quit
  }
  package "NPC 交互 · M5 目标" {
    usecase "N-UC-01\n与 NPC 对话" as Chat
    usecase "N-UC-02\n指挥 NPC 协作" as Orders
    usecase "N-UC-03\n获得 NPC 自主反应" as Agency
  }
}

Player --> Start
Player --> Explore
Player --> Challenge
Player --> Combat
Player --> Results
Player --> Retry
Player --> Menu
Player --> Quit
Player --> Chat
Player --> Orders
Player --> Agency
Challenge --> BossService : 可选 PPO 决策
Chat --> NpcService
Orders --> NpcService
Agency --> NpcService


legend bottom
  用例关联表示角色参与，不表示流程先后。
  重试和返回以结果页为前置条件，不强行添加 include/extend。
  重试从营火起点开始，再次抵达 Boss 才开新 Episode。
  BT 为内部算法；服务只返回建议，UE 校验并执行。
  PPO/NPC 联调仍待验收，关联箭头不表示已执行成功。
  流程与战斗规则见 GDD；验收状态见 01_VerificationMatrix.md。
endlegend
@enduml
