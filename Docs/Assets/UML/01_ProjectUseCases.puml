@startuml ProjectUseCases
' Diagram: SRS-P-01; Model: To-Be / requirements baseline 2026-10-08
' Purpose: whole-group boundary across UE game, Boss RL and NPC service
' UE: develop ea4c8052f5df319c2d3b7b8c8dfcf2f684efb408
' AI: main 1678dd6a467bc2fd9c077124ede527a82958e332
' Evidence: 06_DevelopmentRoadmap.md; GDD/01_GameFlow.md; AI Spec v1.1
title AesirWarden — 整组系统用例总览（需求目标）
left to right direction
skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FAFAF7
skinparam shadowing false
skinparam packageStyle rectangle

actor "玩家" as Player
actor "开发与研究人员" as Researcher
actor "外部大模型服务\n可选协作方" as LLM

rectangle "整组系统：UE 游戏 + Boss RL + NPC 服务" {
  package "UE 游戏 · M1/M4" {
    usecase "G-UC-01～08\n开始、探索、战斗、结算、重试与退出" as Game
  }
  package "Boss RL · M2/M3" {
    usecase "R-UC-01\n训练并选择候选策略" as Train
    usecase "R-UC-02\n部署冻结策略并接入战斗" as Deploy
    usecase "R-UC-03\n执行独立对照评估" as Evaluate
  }
  package "NPC 人格与行为服务 · M5" {
    usecase "N-UC-01\n人格化对话" as Chat
    usecase "N-UC-02\n文本或语音协作指令" as Orders
    usecase "N-UC-03\n自主行为与事件反应" as Agency
    usecase "N-UC-04\n查询状态与决策解释" as Inspect
    usecase "N-UC-05\n重置指定 NPC 记忆" as Reset
  }
}

Player -- Game
Player -- Chat
Player -- Orders
Player -- Agency
Researcher -- Train
Researcher -- Deploy
Researcher -- Evaluate
Researcher -- Inspect
Researcher -- Reset
Chat --> LLM : 可选生成
Orders --> LLM : 可选意图解析
legend bottom
  全项目边界内的 UE、Boss 服务、NPC 服务不重复画作外部参与者。
  本图概括需求，详细游戏图见 02_GameUseCases.puml。
  v1.1 NPC 服务图另以 Python 服务为局部边界，编号独立。
  模拟器与 UE 分开报告，正式对照默认不加入同伴变量。
  记忆重置为服务调试操作，当前不清关系、不承诺游戏内按钮。
endlegend
@enduml
